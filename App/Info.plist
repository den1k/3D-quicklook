<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.local.quicklook3d</string>
	<key>CFBundleName</key>
	<string>3D Quick Look</string>
	<key>CFBundleExecutable</key>
	<string>QuickLook3D</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- macOS has no built-in types for 3MF and STEP, so declare them. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.local.quicklook3d.3mf</string>
			<key>UTTypeDescription</key>
			<string>3MF Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.local.quicklook3d.step</string>
			<key>UTTypeDescription</key>
			<string>STEP Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>step</string>
					<string>stp</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
